{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "paths": {
      "@fenestrator/schemas": ["../../packages/schemas/src"],
      "@fenestrator/core-domain": ["../../packages/core-domain/src"]
    }
  },
  "include": ["src/**/*"]
}
